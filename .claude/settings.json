{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(cd:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(dotnet --version)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet list *)",
      "Bash(dotnet format whitespace:*)",
      "Bash(pwsh Tools/verify-unity-compile.ps1*)",
      "Bash(pwsh -NoProfile -File Tools/verify-unity-compile.ps1*)",
      "WebSearch",
      "WebFetch(domain:docs.unity3d.com)",
      "WebFetch(domain:docs.unity.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
