<Project Sdk="Microsoft.NET.Sdk">

  <!--
    docs/architecture/03-atlas-to-screen.html の図の元データを書き出すコンソールプログラム（使い方は ../README.md）。
    パッケージの Core と Bake を Tests/T2font.Tests.csproj と同じくリンクで引くので、図はインポーターと同じコードの出力になる。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\..\Packages\info.someiyoshino.t2font\Core\**\*.cs" />
    <Compile Include="..\..\..\..\Packages\info.someiyoshino.t2font\Bake\**\*.cs" />
  </ItemGroup>

</Project>
